# Copy to .env and replace both passwords. Keep these values for an existing volume.
DB_PASSWORD=replace-with-a-unique-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
APP_PORT=8092
# Local access through Windows/WSL localhost. Set 0.0.0.0 only for LAN access.
APP_BIND_ADDRESS=127.0.0.1
